# --- Login (cukup JWT) ---
# Ambil dari browser: F12 → Application → Local Storage → https://gem.bullshot.io → rg_jwt_token
JWT=

# Cookie Cloudflare (wajib untuk CLI): Network → request gemapi → Request Headers → cookie
CF_COOKIES=

# --- Mining ---
# id cave dari: node bullgem.js locations
MINING_LOCATION=
MINING_SPOT=
MINING_STRATEGY=balanced
# Interval poll (detik)
POLL_SECONDS=30

# --- Anti-bot (jeda manusiawi) ---
# Jeda acak antar request (ms). Perbesar kalau server sering membalas 429.
HUMAN_MIN_MS=700
HUMAN_MAX_MS=2200
# Retry otomatis saat 429 / 5xx
MAX_RETRY=3
# Berhenti setelah N putaran (0 = tanpa batas)
MAX_ROUNDS=0
# Set 1 untuk mematikan jeda (tidak disarankan)
NO_PACING=0

# --- Lama, tidak dipakai lagi ---
# PRIVATE_KEY=
# EMAIL=
# REF_CODE=
