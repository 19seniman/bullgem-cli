JWT=

# Opsional — hanya kalau `node bullgem.js debug` membalas 403:
# CF_COOKIES=cf_clearance=...; __cf_bm=...

# --- Mining ---
# id cave dari: node bullgem.js locations
MINING_LOCATION=
MINING_SPOT=
MINING_STRATEGY=balanced
# Interval poll (detik)
POLL_SECONDS=30

# --- Auto upgrade ---
# 0 = matikan pembelian upgrade otomatis di loop
AUTO_UPGRADE=1
# Upgrade otomatis maksimal sekali per N jam (default 24 = sekali sehari)
UPGRADE_INTERVAL_HOURS=24
# Sisakan gems segini sebelum membeli upgrade
GEM_RESERVE=0
# Urutan prioritas stat
UPGRADE_PRIORITY=energyCapacity,miningPower

# --- Anti-bot (jeda manusiawi) ---
# Jeda acak antar request (ms). Perbesar kalau server sering membalas 429.
HUMAN_MIN_MS=700
HUMAN_MAX_MS=2200
# Retry otomatis saat 429 / 5xx
MAX_RETRY=3
# Berhenti setelah N putaran (0 = tanpa batas)
MAX_ROUNDS=0
# Set 1 untuk mematikan jeda (tidak disarankan)
NO_PACING=0

