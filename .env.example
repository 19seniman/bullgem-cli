# ---- Login ----
# Isi salah satu. Kalau PRIVATE_KEY ada, wallet login dipakai dan EMAIL diabaikan.
PRIVATE_KEY=
EMAIL=

# JWT dari browser (localStorage rg_jwt_token) — kalau diisi, PRIVATE_KEY/EMAIL dilewati
JWT=

# Opsional
REF_CODE=
# Lokasi tambang default (id dari: node bullgem.js locations)
MINING_LOCATION=
MINING_SPOT=
MINING_STRATEGY=balanced
# Interval poll (detik)
POLL_SECONDS=30

# Kalau kena 403 Cloudflare: tempel cookie dari browser (DevTools → Network → request gemapi → Request Headers → cookie)
# Format: satu baris, apa adanya. Contoh: cf_clearance=abc...; __cf_bm=xyz...
# Berlaku ±30 menit dan terikat ke IP + User-Agent yang sama.
CF_COOKIES=
# Alternatif kalau hanya punya cf_clearance:
CF_CLEARANCE=
